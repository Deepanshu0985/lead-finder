# ── Mistral ─────────────────────────────────────────
MISTRAL_API_KEY=

# ── Reddit (official OAuth, read-only) ──────────────
# Client ID = the short string under your app's name at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format Reddit asks for: <platform>:<app id>:<version> (by /u/<reddit username>)
# Use the Smartvyn Reddit account username, not a personal one.
REDDIT_USER_AGENT=web:smartvyn-lead-finder:1.0.0 (by /u/your_smartvyn_account)
# oauth (default, recommended) | public (unauthenticated .json, often blocked)
REDDIT_MODE=oauth

# ── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard ───────────────────────────────────────
DASHBOARD_PASSWORD=
# Long random string, used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Optional: link added to Telegram messages, e.g. https://smartvyn-leads.vercel.app
DASHBOARD_URL=

# ── Scheduler auth (protects POST /api/run) ─────────
CRON_SECRET=

# ── Supabase ────────────────────────────────────────
SUPABASE_URL=
# Server-only secret key (service_role / sb_secret_...). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
