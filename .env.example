# All of these go in VERCEL (Project → Settings → Environment Variables).
# For local runs, copy this file to .env.local and fill in what you need.
# GitHub only needs CRON_SECRET (secret) and APP_URL (variable) — see README.

# ── Mistral ─────────────────────────────────────────
MISTRAL_API_KEY=

# ── Reddit ──────────────────────────────────────────
# Leave all of this empty to use RSS mode (no keys needed).
# Once Reddit approves your API access, fill in the ID and secret — it switches to the official API automatically.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional. Format: <platform>:<app id>:<version> (by /u/<smartvyn reddit username>)
REDDIT_USER_AGENT=
# Optional override: oauth | rss | public
REDDIT_MODE=

# ── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard ───────────────────────────────────────
DASHBOARD_PASSWORD=
# Long random string to sign the login cookie: `openssl rand -hex 32`
SESSION_SECRET=
# Optional: adds an "Open dashboard" link to Telegram, e.g. https://smartvyn-leads.vercel.app
DASHBOARD_URL=

# ── Scheduler ───────────────────────────────────────
# Any long random string. Put the SAME value in GitHub → Secrets → CRON_SECRET.
CRON_SECRET=

# ── Supabase ────────────────────────────────────────
SUPABASE_URL=
# Server-only secret key (service_role / sb_secret_...). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
